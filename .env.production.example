# Variables para el despliegue (docker-compose.prod.yml).
#
# Uso en la máquina de despliegue:
#   cp .env.production.example .env
#   # completar los valores y:  ./deploy.sh
#
# Docker Compose lee `.env` del directorio del proyecto automáticamente.

# --- Requeridos (generarlos: openssl rand -hex 32) -------------------------
# Secret de JWT del backend (firmar/verificar tokens).
JWT_SECRET=

# Clave del panel admin (/admin). El backend la deshabilita si falta.
ADMIN_API_KEY=

# --- Opcionales (defaults en el compose) -----------------------------------
# Contraseña de Postgres. Default: coffee (bien para red interna; cambiar
# si algún día se publica el puerto, que no debería pasar).
#POSTGRES_PASSWORD=coffee

# URL pública del sitio (metadataBase → OG/SEO). Se hornea en el build de
# la imagen web. Poner la URL real al desplegar:
#   Tailscale:  https://<host>.tailnet.ts.net
#   CF Tunnel:  https://tudominio.com
#NEXT_PUBLIC_SITE_URL=http://localhost

# --- Login con Google (opcional) ────────────────────────────────────────────
# OAuth Client ID (Web) de Google. Debe coincidir en frontend (build) y backend
# (runtime). Si falta: el botón de Google no se renderiza y el login con Google
# queda deshabilitado — el login por email sigue funcionando.
# Backend necesita GOOGLE_CLIENT_ID; el frontend necesita
# NEXT_PUBLIC_GOOGLE_CLIENT_ID (mismo valor).
#GOOGLE_CLIENT_ID=
#NEXT_PUBLIC_GOOGLE_CLIENT_ID=
