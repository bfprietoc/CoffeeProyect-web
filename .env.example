# Base URL de la API (FRONTEND_PLAN.md → "Contrato con el backend")
# Dev: backend en local — Prod (mini PC): "/api" relativo, ruteado por Caddy
NEXT_PUBLIC_API_URL=http://localhost:8080

# Login con Google: OAuth Client ID (tipo Web) de Google Cloud Console.
# Si falta, el botón de Google no aparece y todo lo demás funciona igual.
#NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# Pagos con Wompi (Feature B). "true" muestra el botón de pago en /orders/[id];
# cualquier otro valor lo oculta (CI/E2E corren sin el pago). El backend debe
# tener WOMPI_PUBLIC_KEY/_INTEGRITY_SECRET/_EVENT_SECRET/PUBLIC_BASE_URL
# configurados o responde 503 PAYMENTS_DISABLED.
#NEXT_PUBLIC_PAYMENTS_ENABLED=true
